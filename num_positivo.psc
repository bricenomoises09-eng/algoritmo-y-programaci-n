Algoritmo num_positivo
	definir num como entero;
	
	Escribir " ingrese el numero a valuar:";
	Leer num;
	
	si num > 0 Entonces
		escribir " el numero ingresado en positivo y es :", num;
		
	FinSi
	
		si num < 0 Entonces
			escribir " el numero ingresado en negativo y es :", num;
			
		FinSi
		
	
	escribir "fin del programa.";
	
	
	
FinAlgoritmo
