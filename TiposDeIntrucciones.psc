Algoritmo TiposDeIntrucciones
	
	// instrucciones de declaracion
	definir n1, n2, resultado Como Entero
	// intruccion de entrada
	leer n1
	
	// instruccion de asignacion
	n2=10
	resultado = n1 + n2
	
	// intruccion selectiva
	si  resultado = 15 entonces
		// instruccion de salida 
		escribir "el numero supera el limite."
		
	FinSi
	
	

FinAlgoritmo
